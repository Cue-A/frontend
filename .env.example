# 백엔드 REST 기본 주소.
# 로컬에서 백엔드를 띄웠다면 http://localhost:8080 처럼 적습니다.
# 미정이면 비워두고 VITE_USE_MOCK=true 로 쓰세요.
VITE_API_BASE_URL=

# true 면 실제 API 대신 목업 응답을 사용합니다.
VITE_USE_MOCK=true

# 목업을 켜둔 채로 **여기 적은 도메인만** 실제 서버로 보냅니다.
#
# 백엔드는 엔드포인트를 한 번에 다 올리지 않습니다. 준비된 것만 여기 적으면
# 나머지 화면은 목업으로 계속 돌아갑니다. 면접이 올라오면 한 줄 늘리세요.
#
#   VITE_REAL_APIS=auth,users
#   VITE_REAL_APIS=auth,users,interview-sessions
#
# 접두어(/api · /v1 · /ws)를 건너뛴 첫 조각이 도메인입니다.
#   auth               → /api/auth/login
#   interview-sessions → /v1/interview-sessions , /ws/v1/interview-sessions/{id}
#
# 지금 면접 경로는 아직 /api/interviews 라서 도메인 이름이 interviews 입니다.
# /v1/interview-sessions 로 바뀌면 그때 이름도 같이 바꿔주세요. (이슈 #32 4번)
#
# 비워두면 전부 목업입니다. VITE_USE_MOCK=false 면 이 값과 관계없이 전부 실제입니다.
VITE_REAL_APIS=
