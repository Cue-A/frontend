# 백엔드 REST 기본 주소.
# 로컬에서 백엔드를 띄웠다면 http://localhost:8080 처럼 적습니다.
# 미정이면 비워두고 VITE_USE_MOCK=true 로 쓰세요.
VITE_API_BASE_URL=

# true 면 실제 API 대신 목업 응답을 사용합니다.
VITE_USE_MOCK=true

# 목업을 켜둔 채로 **여기 적은 도메인만** 실제 서버로 보냅니다.
#
# 백엔드는 엔드포인트를 한 번에 다 올리지 않습니다. 준비된 것만 여기 적으면
# 나머지 화면은 목업으로 계속 돌아갑니다.
#
#   VITE_REAL_APIS=auth,users
#   VITE_REAL_APIS=auth,users,documents,interviews,reports,companies,practice-records,folders,bookmarks,home
#
# 배포 서버에 있는 도메인 전부(2026-11-10 기준)는 이렇습니다. 배포(Vercel)도 이 값을 씁니다.
#
#   VITE_REAL_APIS=auth,users,documents,interviews,reports,companies,practice-records,folders,bookmarks,home,growth,calendar,common-questions
#
# 접두어(/api · /v1 · /ws)를 건너뛴 첫 조각이 도메인입니다.
#   auth             → /api/auth/login
#   users            → 내 정보 /api/users/me · 프로필 /me/profile · 계정 정보 /me/account · 탈퇴 DELETE /me ·
#                      이메일 변경 /me/email · 비밀번호 변경 /me/password (Cue-A/backend#64 · #125~#128).
#                      알림 설정은 백엔드에 없어 켜도 목업이 답합니다
#   documents        → /api/documents
#   interviews       → /api/interviews , /ws/interviews/{id} , 리포트 분석 등록 /api/interviews/{id}/reports
#                      (리포트 진행 소켓 /ws/reports/{id} 도 등록을 따라 같이 켜집니다)
#   reports          → 리포트 상세 · 상태 조회 · 다시 분석 · 회차 비교 /api/reports/{id}/... . **interviews 를 켤 때 같이 켜세요.**
#                      한쪽만 켜면 상태 조회를 건너뜁니다
#   companies        → 기업 목록 · 상세 /api/companies/{id} · 관심 기업 /api/companies/interests (옵션 설정 · 기업 탐색 · 마이페이지)
#   practice-records → 연습 기록 목록 /api/practice-records · 폴더로 옮기기 /api/practice-records/folder
#   folders          → 연습 기록 폴더 만들기 · 이름 바꾸기 · 삭제 /api/folders . practice-records 와 같이 켜세요
#                      (폴더 숫자와 목록이 같은 서버여야 맞습니다)
#   home             → 홈 이번 달 · 연속 학습 /api/home/stats · 연습 기록 /api/home/practice · 최근 리포트 /api/home/recent-reports .
#                      인재상 · 질문은행(/api/home)은 백엔드에 없어 켜도 목업이 답합니다. 홈의 목표 · 배지는 growth,
#                      다가오는 면접일은 calendar 를 따릅니다.
#                      성장 관리의 가장 최근 리포트도 /api/home/recent-reports 라 growth 를 쓸 때 같이 켜세요
#   bookmarks        → 질문 은행 북마크 · 메모 /api/bookmarks (Cue-A/backend#118 · main 반영 #120)
#   common-questions → 질문 은행 공통 질문 /api/common-questions (조회 · 즐겨찾기 · 메모 · 내 질문 추가 · 수정 · 삭제)
#   public           → 공유 링크로 연 리포트 /api/public/reports/{shareId} (로그인 없이 부름, Cue-A/backend#137).
#                      **따로 적지 않아도 reports 를 따라 켜집니다.** 링크 만들기 · 해제(/api/reports/{id}/share)가 reports 라서,
#                      한쪽만 실서버면 만든 링크를 다른 쪽이 못 찾아 늘 404 입니다 (shared/api/mock.ts LINKED_DOMAINS)
#   growth           → 이번 주 목표 · 배지 /api/growth · /api/growth/weekly-goal (Cue-A/backend#132 · #134).
#                      성장 관리와 홈의 목표 · 배지 칸이 같이 씁니다
#                      (점수 추이 · 이전 회차 대비 변화는 reports 의 회차 비교입니다)
#   calendar         → 면접 캘린더 /api/calendar (월별 조회 · 일정 등록 · 수정 · 삭제) · 홈 다가오는 면접일
#                      /api/calendar/events/upcoming (Cue-A/backend#133)
#
# 켠 도메인 안이라도 **백엔드에 아직 없는 API** 는 목업이 답합니다 (콘솔에 [목업] 으로 한 번 찍힙니다).
# 어떤 API 인지는 각 도메인 목업 파일에서 `missingInBackend` 를 찾아보세요. (shared/api/mock.ts)
#
# 비워두면 전부 목업입니다. VITE_USE_MOCK=false 면 이 값과 관계없이 전부 실제입니다.
VITE_REAL_APIS=

# 카카오 로그인 (AUTH-2). REST API Key 는 인가 URL 에 그대로 노출되는 값이라
# 공개되어도 되지만, 값은 이슈 #53 에 있으니 거기서 복사해 .env.local 에 넣으세요.
# Redirect URI 는 카카오에 등록된 주소와 글자 하나까지(끝 슬래시 · http/https 포함)
# 같아야 합니다 — 로컬과 배포 주소가 다릅니다.
VITE_KAKAO_REST_API_KEY=
VITE_KAKAO_REDIRECT_URI=
