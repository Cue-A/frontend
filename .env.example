# 백엔드 REST 기본 주소. 미정이면 비워두고 VITE_USE_MOCK=true 로 쓰세요.
VITE_API_BASE_URL=

# true 면 실제 API 대신 목업 응답을 사용합니다.
VITE_USE_MOCK=true

# 카카오 로그인 (AUTH-2). REST API Key 는 인가 URL 에 그대로 노출되는 값이라
# 공개되어도 됩니다. Redirect URI 는 카카오에 등록된 주소와 글자 하나까지
# (끝 슬래시 · http/https 포함) 같아야 합니다 — 로컬은 이 값, 배포는 따로 두세요.
VITE_KAKAO_REST_API_KEY=ec3dc3f66366b5d9157d752b3011b8bf
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
